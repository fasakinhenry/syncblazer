VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000

# Optional: enables the "Continue with Google" button. Must match the
# backend's GOOGLE_CLIENT_ID. Leave blank to hide the button.
VITE_GOOGLE_CLIENT_ID=

# Optional: only used when this build runs inside the desktop app (Tauri).
# A SEPARATE "Desktop app" type OAuth client from VITE_GOOGLE_CLIENT_ID
# above — create one at console.cloud.google.com/apis/credentials, must
# match the backend's GOOGLE_DESKTOP_CLIENT_ID. Leave blank to disable
# Google sign-in specifically inside the desktop app (guest/password still
# work there either way).
VITE_GOOGLE_DESKTOP_CLIENT_ID=

VITE_ADMIN_EMAILS=